Resources
| where type == "microsoft.authorization/roleassignments"
| where properties.principalType == "ServicePrincipal"
| where properties.roleDefinitionId endswith "/providers/Microsoft.Authorization/roleDefinitions/8e3af657-a8ff-443c-a75c-2fe8c4bcb635"   // Owner
   or properties.roleDefinitionId endswith "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"  // Contributor
| where properties.scope matches regex @"/subscriptions/[0-9a-fA-F\-]+$"
| project id, name, properties.roleDefinitionId, properties.scope, properties.principalType
| order by id asc
