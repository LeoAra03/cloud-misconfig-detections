{
  "detection": "AZ-02",
  "cloud": "azure",
  "title": "NSG rule 0.0.0.0/0 on 22 or 3389",
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "nsg-frontend",
      "id": "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/rg-prod/providers/Microsoft.Network/networkSecurityGroups/nsg-frontend",
      "properties": {
        "securityRules": [
          {
            "name": "AllowSSH-In",
            "direction": "Inbound",
            "access": "Allow",
            "priority": 100,
            "sourceAddressPrefix": "0.0.0.0/0",
            "destinationPortRange": "22",
            "protocol": "Tcp"
          },
          {
            "name": "AllowRDP-In",
            "direction": "Inbound",
            "access": "Allow",
            "priority": 110,
            "sourceAddressPrefix": "0.0.0.0/0",
            "destinationPortRange": "3389",
            "protocol": "Tcp"
          }
        ]
      }
    }
  ]
}
